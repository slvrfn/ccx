# Copy is generated at ~/.claude-context-cli/.env by ccx init.
# Secrets are never embedded in OpenCode JSON or export bundles.
INFERENCE_API_HOST=host.docker.internal
INFERENCE_API_PORT=8080
INFERENCE_API_BASE_URL=
INFERENCE_API_KEY=local-inference
INFERENCE_MODEL=local-coder
EMBEDDING_API_HOST=host.docker.internal
EMBEDDING_API_PORT=8081
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=local-embedding
EMBEDDING_MODEL=local-embedding
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:2.1.2
CLAUDE_CONTEXT_VERSION=0.1.15
GRAPHIFY_VERSION=0.9.83
GRAPHIFY_ENABLED=true
GRAPHIFY_OUT_DIR=graphify-out
GRAPHIFY_SEMANTIC_EXTRACTION=false
GRAPHIFY_COMMIT_OUTPUT=false
WATCH_DEBOUNCE_SECONDS=5
INDEX_TIMEOUT_SECONDS=3600
COMMAND_TIMEOUT_SECONDS=3600
# Container-side project Python tooling. These paths live in the persistent HOME volume.
UV_CACHE_DIR=/home/ccx/.cache/uv
UV_PROJECT_ENVIRONMENT=/home/ccx/.venvs/project
UV_HTTP_TIMEOUT=300
UV_CONCURRENT_DOWNLOADS=2
UV_LINK_MODE=copy
# OpenCode's own shell-tool deadline (milliseconds), separate from ccx command timeouts.
OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS=1800000
MILVUS_IMAGE=milvusdb/milvus:v2.5.6
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.18
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
ATTU_IMAGE=zilliz/attu:v2.5.0
MILVUS_PORT=19530
MINIO_CONSOLE_PORT=9001
ATTU_PORT=8000
MINIO_ROOT_USER=ccx
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATED_ON_INIT
